{
  "name": "kingofyadav-in",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:static": "node scripts/dev-server.js",
    "dev:api": "node server/otp-server.js",
    "tunnel": "ngrok start site --config ~/snap/ngrok/common/.config/ngrok/ngrok.yml",
    "tunnel:all": "ngrok start site api --config ~/snap/ngrok/common/.config/ngrok/ngrok.yml",
    "start": "node server/otp-server.js",
    "api": "node server/otp-server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "migrate:dry": "node scripts/migrate.js --dry-run",
    "build:sw": "node scripts/bump-sw-version.js",
    "build:blog": "node scripts/build-blog.js",
    "build:css": "node scripts/build-css.js",
    "build:tokens": "node scripts/build-brand-tokens.js",
    "build:version": "node scripts/build-version.js",
    "build:sitemap": "node scripts/build-sitemap.js",
    "build": "npm run build:tokens && npm run build:sw && npm run build:blog && npm run build:css && npm run build:sitemap && npm run build:version",
    "predeploy": "npm run build",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand --ci --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "jest": "^29.7.0",
    "playwright": "^1.60.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "api/**/*.js",
      "lib/auth-handlers/**/*.js",
      "!api/_*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 60
      },
      "./lib/auth-handlers/**": {
        "lines": 80
      },
      "./api/wallet/**": {
        "lines": 80
      }
    }
  }
}
